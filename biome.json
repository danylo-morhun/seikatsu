{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useKeyWithClickEvents": "off",
				"useFocusableInteractive": "off",
				"useSemanticElements": "off",
				"noSvgWithoutTitle": "off",
				"noAutofocus": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noDocumentCookie": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off",
				"noBlankTarget": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/dist",
			"!**/.turbo",
			"!**/*.lock",
			"!**/graphify-out",
			"!**/.claude",
			"!**/.impeccable",
			"!**/.playwright-mcp",
			"!**/.vercel",
			"!**/test-results",
			"!**/playwright-report",
			"!**/e2e/.auth",
			"!**/.local",
			"!**/*.md"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
