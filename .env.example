# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth v5
AUTH_SECRET="generate-with: openssl rand -hex 32"
AUTH_URL="https://yourdomain.com"

# Optional — base URL used server-side for email links (password reset, etc). Defaults to http://localhost:3000
NEXTAUTH_URL="https://yourdomain.com"

# GitHub OAuth App
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# Google OAuth App — optional, sign-in works without it (falls back to empty client id/secret)
# 1. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# 2. Set the authorized redirect URI to: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Resend — powers magic-link email sign-in. Optional, falls back to empty API key
# 1. Get an API key at https://resend.com/api-keys
# 2. AUTH_EMAIL_FROM must be a verified sender/domain in Resend
RESEND_API_KEY="your-resend-api-key"
AUTH_EMAIL_FROM="seikatsu <noreply@seikatsu.danylomorhun.com>"

# Enable Banking (Open Banking / PSD2 AIS) — free for personal use (Restricted Production)
# 1. Sign up at https://enablebanking.com/cp/applications and add an application
# 2. Set the redirect URL to: <AUTH_URL>/api/kuroji/bank/callback
# 3. On create, it downloads an <application-id>.pem private key
#    - APP_ID is the .pem filename without extension
#    - PRIVATE_KEY is the file contents (replace real newlines with \n to keep it one line)
ENABLE_BANKING_APP_ID="your-application-id"
ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron auth — Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"

# Gemini API — used by Kyuu's "paste job posting" autofill (free tier)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
