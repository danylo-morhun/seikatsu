# Calls /api/cron/<instance> on the local app (sk-cron@notify, sk-cron@recurring, sk-cron@sync-banks).
[Unit]
Description=seikatsu cron: %i
After=seikatsu.service
Requisite=seikatsu.service

[Service]
Type=oneshot
User=seikatsu
EnvironmentFile=/srv/seikatsu/shared/.env.production.local
ExecStart=/bin/sh -c "curl -fsS --max-time 240 -o /dev/null -H \"Authorization: Bearer $${CRON_SECRET}\" http://127.0.0.1:3100/api/cron/%i"
