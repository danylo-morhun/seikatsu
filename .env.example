# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth v5
AUTH_SECRET="generate-with: openssl rand -hex 32"
AUTH_URL="https://yourdomain.com"

# GitHub OAuth App
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# Enable Banking (Open Banking / PSD2 AIS) — free for personal use (Restricted Production)
# 1. Sign up at https://enablebanking.com/cp/applications and add an application
# 2. Set the redirect URL to: <AUTH_URL>/api/kuroji/bank/callback
# 3. On create, it downloads an <application-id>.pem private key
#    - APP_ID is the .pem filename without extension
#    - PRIVATE_KEY is the file contents (replace real newlines with \n to keep it one line)
ENABLE_BANKING_APP_ID="your-application-id"
ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron auth — Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"
